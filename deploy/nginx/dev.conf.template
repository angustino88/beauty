# Development: HTTP on port 80 and HTTPS on port 443 (self-signed certificate from deploy/gen-dev-cert.sh).

map "" $hsts_header {
    default "";
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name ${SERVER_NAME};

    ssl_certificate /etc/nginx/ssl/${SSL_CERT_NAME}.crt;
    ssl_certificate_key /etc/nginx/ssl/${SSL_CERT_NAME}.key;

    server_tokens off;
    client_max_body_size 20M;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    include /etc/nginx/conf.d/api-${API_MODE}.inc;
    include /etc/nginx/snippets/spa.inc;
}
