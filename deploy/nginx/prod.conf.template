# Production: HTTPS only; plain HTTP redirects.

map "" $hsts_header {
    default "max-age=31536000";
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

gzip on;
gzip_types application/json application/javascript text/css text/plain image/svg+xml;
gzip_min_length 1024;

server {
    listen 80 default_server;
    server_name ${SERVER_NAME};
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name ${SERVER_NAME};

    ssl_certificate /etc/nginx/ssl/${SSL_CERT_NAME}.crt;
    ssl_certificate_key /etc/nginx/ssl/${SSL_CERT_NAME}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 20M;

    include /etc/nginx/conf.d/api-${API_MODE}.inc;
    include /etc/nginx/snippets/spa.inc;
}
