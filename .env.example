# LabMango frontend configuration (Vite). Copy to .env.local (dev) or .env.production and fill in.

# ---- Backend connection --------------------------------------------------------------------------
# direct : one backend at VITE_API_URL (single-department deployment, no Router).            [default]
# router : several department backends behind the LabMango Router at VITE_ROUTER_URL. After Microsoft
#          sign-in the frontend asks the Router which backend serves the user and then calls
#          VITE_ROUTER_URL/t/<prefix_key>/... for every API, WebSocket and refresh-token request.
VITE_API_MODE=direct

# Backend origin (direct mode). Empty = the page's own origin: the frontend nginx (Docker) proxies /api/, /ws/
# and /media/ to BACKEND_UPSTREAM, and `npm run dev` proxies them to DEV_PROXY_TARGET.
VITE_API_URL=

# Router origin (router mode). Empty = the page's own origin: the frontend nginx proxies /routing/ and /t/ to
# ROUTER_UPSTREAM. When set to another origin, the Router's CORS_ALLOWED_ORIGINS must contain this frontend.
# The Router's AAD_AUDIENCE must equal VITE_CLIENT_ID.
VITE_ROUTER_URL=

# ---- Microsoft Entra ID (MSAL) -------------------------------------------------------------------
VITE_CLIENT_ID=
VITE_TENANT_ID=
VITE_REDIRECT_URI=http://localhost:3000/about
VITE_APP_URL=http://localhost:3000/

# ---- Other ---------------------------------------------------------------------------------------
VITE_WS_URL_CHATBOT=
# Agent enrollment URL shown in the agent setup dialog. In router mode it defaults to the user's
# backend prefix on the Router; set it only to override.
VITE_AGENT_URL=

# ---- npm run dev ---------------------------------------------------------------------------------
# With empty VITE_API_URL / VITE_ROUTER_URL the Vite dev server proxies /api, /ws, /media, /routing and /t/
# here: the backend (direct mode) or the Router's nginx (router mode).
DEV_PROXY_TARGET=http://127.0.0.1:8000

# ---- Docker / nginx (docker-compose.dev.yml, docker-compose.prod.yml) -----------------------------
# Where the frontend nginx proxies the API. Direct mode: the backend. Router mode: the Router's nginx.
BACKEND_UPSTREAM=https://host.docker.internal:8443
ROUTER_UPSTREAM=http://host.docker.internal:8080
# Public host name (prod) and certificate: $SSL_DIR/$SSL_CERT_NAME.crt and .key
SERVER_NAME=labmango.com
SSL_CERT_NAME=labmango
SSL_DIR=./ssl_certificates
