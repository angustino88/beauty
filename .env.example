# LabMango frontend configuration (Vite). Copy to .env.local (dev) or .env.production and fill in.

# ---- Backend connection --------------------------------------------------------------------------
# direct : one backend at VITE_API_URL (single-department deployment, no Router).            [default]
# router : several department backends behind the LabMango Router at VITE_ROUTER_URL. After Microsoft
#          sign-in the frontend asks the Router which backend serves the user and then calls
#          VITE_ROUTER_URL/t/<prefix_key>/... for every API, WebSocket and refresh-token request.
VITE_API_MODE=direct

# Backend origin (direct mode), e.g. http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# Router origin (router mode), e.g. http://localhost:8080 locally or https://router.example.com.
# Falls back to VITE_API_URL when empty. The Router's AAD_AUDIENCE must equal VITE_CLIENT_ID, and its
# CORS_ALLOWED_ORIGINS must contain this frontend's origin.
VITE_ROUTER_URL=

# ---- Microsoft Entra ID (MSAL) -------------------------------------------------------------------
VITE_CLIENT_ID=
VITE_TENANT_ID=
VITE_REDIRECT_URI=http://localhost:3000/about
VITE_APP_URL=http://localhost:3000/

# ---- Other ---------------------------------------------------------------------------------------
VITE_WS_URL_CHATBOT=
# Agent enrollment URL shown in the agent setup dialog. In router mode it defaults to the user's
# backend prefix on the Router; set it only to override.
VITE_AGENT_URL=
